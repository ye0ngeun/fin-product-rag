# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다. (NF2003)

# 금융감독원 금융상품한눈에 Open API 인증키 (32자리)
FSS_API_KEY=

# SSAFY GMS (OpenAI 호환 엔드포인트)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# 위키백과 API User-Agent: 프로젝트명/버전 (연락처) 형식 (NF2006)
WIKI_USER_AGENT=fin-product-rag/0.1 (your-email@example.com)
