# 비밀값
.env

# 수집 원본·가공 데이터 (출처 이용조건상 재배포하지 않음)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Vector DB
chroma_db/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# IDE / OS
.vscode/
.idea/
.DS_Store

# 제출물: 스크린샷은 금감원 공시값이 보여 git 에 올리지 않고 zip 에만 넣는다
docs/screenshots/*
!docs/screenshots/.gitkeep
